# nightshift runtime state — never committed to the control repo in the prototype
/state/
/runs/
/digests/
/sandbox/
/worktrees/
rulebook.yaml

# Harness-created task worktrees. Scoped to the subdirectory, NOT all of .claude/, so a
# project-level .claude/settings.json or skill stays committable.
/.claude/worktrees/

# CPython bytecode. The suite imports lib/egress_proxy.py, so a tracked __pycache__ would let the
# suite dirty its own worktree — which ADR 0027 refuses to ship. bin/setup-sandbox.sh:44 already
# teaches the demo repo this; the control repo has to hold to it too.
__pycache__/
*.py[cod]
